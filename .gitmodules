# Only one real submodule remains.
#
# This file used to list twelve, but eleven of those paths were vendored into
# the repository as ordinary files at some point without their entries being
# removed. Git only ever created a gitlink for assets/protobuf, so every
# `git submodule update --init --recursive` -- which is what
# actions/checkout does with `submodules: recursive` -- walked into a path
# that is not a submodule and failed. That is why CI could not check this
# repository out at all.
[submodule "assets/protobuf"]
	path = assets/protobuf
	url = https://github.com/DarkFlippers/flipperzero-protobuf.git
	shallow = false
