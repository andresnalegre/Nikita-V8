            }
          ]
        },
        {
          "version": "nkt-029",
          "changelog": "Nikita firmware nkt-029. Fixes the WiFi scan furi_check crash (expansion service USART collision + CLI UART overrun) and returns real AP results. scanap is the reliable AP scan. End-to-end marauder CLI. Authorised testing only.",
          "timestamp": 1790071037,
          "files": [
            {
              "url": "https://github.com/andresnalegre/Nikita-V8/releases/download/nkt-029/flipper-z-f7-update-nkt-029.tgz",
