              "type": "update_tgz",
              "sha256": "3ae120a2cc6fd6f6028d44b2ca4f52287f602b69dd6bc735b720b8c131009243"
            }
          ]
        },
        {
          "version": "nkt-026",
          "changelog": "Nikita firmware nkt-026. WIFI app two-level menu -- pick a category and see EVERY option (all attacks, all sniffs, BLE spam). Board output teed to /ext/apps_data/nikita_wifi/last.log. New built-in marauder CLI command: run any Marauder command over the Flipper shell and get output back (Nikita end-to-end WiFi). Authorised testing only.",
          "timestamp": 1790067601,
          "files": [
            {
              "url": "https://github.com/andresnalegre/Nikita-V8/releases/download/nkt-026/flipper-z-f7-update-nkt-026.tgz",
