            }
          ]
        },
        {
          "version": "nkt-025",
          "changelog": "Nikita firmware nkt-025. WIFI in the MAIN MENU (wifi icon). WIFI app now full ESP32 Marauder parity: 35 categories -- scan/recon/list/select, attacks + BLE spam, beacon, targeted, port scan, full sniff set (PMKID/pwn/BT/airtag...), fox hunt, evil portal, wardrive, GPS, channel, LED, settings, keyboard args. Authorised testing only.",
          "timestamp": 1790064056,
          "files": [
            {
              "url": "https://github.com/andresnalegre/Nikita-V8/releases/download/nkt-025/flipper-z-f7-update-nkt-025.tgz",
