        },
        {
          "version": "nkt-030",
          "changelog": "Nikita firmware nkt-030. WIFI command mailbox (bridge-free: write /ext/apps_data/nikita_wifi/cmd, read last.log), snapshot logging (reads never hang), crash-hardened. Verified: 58 APs via mailbox, no crash. Authorised testing only.",
          "timestamp": 1790083859,
          "files": [
            {
              "url": "https://github.com/andresnalegre/Nikita-V8/releases/download/nkt-030/flipper-z-f7-update-nkt-030.tgz",
