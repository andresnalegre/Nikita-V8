              "sha256": "ae12aa40841ac207eef86468574082dbc89fbb281ad6ada77424be9188b1fa4b"
            }
          ]
        },
        {
          "version": "nkt-024",
          "changelog": "Nikita firmware nkt-024. WIFI is now a top-level MAIN MENU app with its own wifi icon (no longer buried in GPIO), turbocharged to the full ESP32 Marauder command set: channel picker (1-14), scan/list AP+station, sniff beacon/probe/deauth/PMKID/pwnagotchi/raw/ESP, deauth (all+targeted), beacon spam (list/random/AP-clone), probe flood, rickroll, wardrive, clear lists, reboot, stop. Authorised testing only.",
